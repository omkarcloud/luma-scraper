dle":"bondcommunityai","is_verified":false,"linkedin_handle":"/company/bond-ai-community","name":"Sahar Mor (Bond AI)","tiktok_handle":null,"timezone":"America/Mexico_City","twitter_handle":"bondaicommunity","username":"saharmor","website":"http://bondcommunity.ai/","youtube_handle":null},{"api_id":"usr-bPvv5UFudwRbAho","avatar_url":"https://images.lumacdn.com/uploads/o5/d3fcb403-252e-49df-973f-a10813ae1ad0.jpg","bio_short":"","first_name":"Dominic","last_name":"Smith","instagram_handle":"241_dom","is_verified":false,"linkedin_handle":"/in/domedsmith","name":"Dominic Smith","tiktok_handle":null,"timezone":"America/New_York","twitter_handle":"241_dom","username":null,"website":"https://www.visionbrewinteractive.com","youtube_handle":null}],"referred_by":null,"cover_image":{"colors":["#050a0a","#1c508f","#89d179","#cfbca8"],"palette":{"neutral":[{"color":"#050a0a","percentage":42.97},{"color":"#cfbca8","percentage":0.85}],"vibrant":[{"color":"#1c508f","percentage":6.44},{"color":"#89d179","percentage":1.01},{"color":"#7e654f","percentage":1.93}]}},"cover_video":null,"social_image":{"cdn_url":"https://images.lumacdn.com/event-social/0x/a4b5b96e-410e-4ded-8113-3ca45d329e09.png","width":1200,"height":630,"mime_type":"image/png"},"social_video":null,"sessions":[],"ticket_types":[{"api_id":"ttype-OQviAmlnOtPCF3b","cents":null,"currency":null,"description":null,"end_at":null,"ethereum_token_requirements":[],"event_api_id":"evt-earYmAwU5HcrccN","is_flexible":false,"is_hidden":false,"max_capacity":null,"max_per_guest":null,"membership_restriction":null,"min_cents":null,"position":"8","name":"Standard","require_approval":true,"start_at":null,"time_window_name_format":null,"timezone":null,"tint_color":null,"type":"free","valid_end_at":null,"valid_start_at":null,"num_tickets_registered":464,"num_guests":464,"spots_remaining":null,"is_disabled":false}],"featured_infos":[{"type":"discover","avatar_url":"https://images.lumacdn.com/discovery/nyc-icon.png","tint_color":"#e08d55","name":"New York","api_id":"discplace-Izx1rQVSh8njYpP","name_raw":"New York","path":"/nyc"},{"type":"calendar","avatar_url":"https://images.lumacdn.com/calendars/cd/1e0ee2a8-527c-418f-8be0-624a44f5601a.png","name":"Bond AI - New York","path":"/genai-ny","calendar_api_id":"cal-r8BcsXhhHYmA3tp","calendar_type":"calendar_discover"}],"categories":[{"api_id":"cat-ai","description":"Join a hackathon, learn about LLMs and prompt engineering, or connect with other AI practitioners.","event_count":3226,"hero_image_desktop_url":"https://images.lumacdn.com/uploads/42/5719a861-c421-4624-a9dc-8b8b73e3cf57.png","icon_url":"https://images.lumacdn.com/uploads/0z/c1143c0e-a2ab-4434-b82b-80b0ba3ec2f0.png","name":"AI","page_title":"AI Events","simple_icon_url":"https://images.lumacdn.com/uploads/2g/4121b0fa-bd9e-4a50-ad85-cf0000b6d919.png","slug":"ai","social_image_url":"https://images.lumacdn.com/uploads/c1/486065e1-2511-4577-a0e0-5eb683d38a3d.png","subscriber_count":115563,"tint_color":"#D96D9B"}],"ticket_info":{"price":null,"is_free":true,"max_price":null,"is_sold_out":false,"spots_remaining":36,"is_near_capacity":false,"require_approval":true},"registration_availability":"sold-out","subscribed_to_calendar":false,"collaborating_calendars":[],"event_invite":null,"manager_info":null,"guest_info":null,"host_info":null,"sold_out":false,"locale":"en","theme_meta":{"theme":"matrix"},"ticket_transfer_enabled":false,"tint_color":"#060b0a","can_register_for_multiple_tickets":false,"font_title":"ivy-mode","description_mirror":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"Event site: ","type":"text"},{"text":"https://worn-hacks.com","type":"text","marks":[{"type":"link","attrs":{"href":"https://worn-hacks.com"}}]}]},{"type":"heading","attrs":{"level":2},"content":[{"text":"📋 Event Description","type":"text"}]},{"type":"paragraph","content":[{"text":"Two days and real smart glasses on your face. Join us at CUNY City Tech, 285 Jay St, Brooklyn, rooms A105 and A103, with MicroLumin, the Shenzhen team behind the CES 2026 award-winning M6 display glasses, and build the first wave of apps for waveguide display glasses.","type":"text"}]},{"type":"paragraph","content":[{"text":"Brought to you by MicroLumin, Waftech, localhost:nyc and Wardah. In partnership with Cornell Tech AI Society, AI and Blockchain Club, and the Indonesian Association at Cornell Tech.","type":"text"}]},{"type":"paragraph","content":[{"text":"This is a hands-on hardware hackathon for engineers and builders who would rather ship on real devices than talk about the future of spatial computing.","type":"text"}]},{"type":"heading","attrs":{"level":2},"content":[{"text":"Problem Statement","type":"text"}]},{"type":"paragraph","content":[{"text":"Smart glasses are finally light enough to wear all day. What's missing is software that feels natural to use. Your challenge is to build anthropocentric interfaces: apps that start from how people see, move, talk and pay attention, not from how phones work. These should be things you'd actually keep on your face.","type":"text"}]},{"type":"heading","attrs":{"level":2},"content":[{"text":"The Challenge Theme","type":"text"}]},{"type":"paragraph","content":[{"text":"Theme: Second nature.","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","content":[{"text":"Build wearable AI that understands you, moves with you, and feels effortless.","type":"text"}]},{"type":"paragraph","content":[{"text":"Three tracks — pick one:","type":"text"}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Track 01 · Personal Insight — AI that understands the person wearing it. Track partner: Wardah.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Track 02 · Seamless Handoff — Moves fluidly between your phone and your glasses.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Track 03 · Natural Interaction — So natural you forget it’s there.","type":"text"}]}]}]},{"type":"paragraph","content":[{"text":"Ideas you might explore:","type":"text"}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Heads-up assistants that show the right info at the right moment","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Live captioning, translation and conversation memory","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Navigation and wayfinding without looking down at a phone","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Accessibility for low-vision, hard-of-hearing and neurodivergent users","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Hands-free workflows for field techs, clinicians, chefs and mechanics","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"New input patterns: voice, ring, head motion and glanceable UI","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Making the glasses useful with AI on what the camera sees","type":"text"}]}]}]},{"type":"heading","attrs":{"level":2},"content":[{"text":"Wardah Personal Face Analysis challenge","type":"text"}]},{"type":"paragraph","content":[{"text":"Track 01 · Personal Insight, presented with Wardah. Indonesia’s leading halal beauty brand, from PT Paragon Technology and Innovation.","type":"text"}]},{"type":"paragraph","content":[{"text":"The challenge: Prototype a hands-free consultation using a sample PFA result.","type":"text"}]},{"type":"paragraph","content":[{"text":"What to demo:","type":"text"}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Start from a sample PFA result","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"One product recommendation","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Why it suits the desired look","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"The placement cue a Beauty Advisor could use","type":"text"}]}]}]},{"type":"paragraph","content":[{"text":"Open to all teams. Judged alongside all tracks. Deadline: Sat Nov 21 · 2:00 PM ET.","type":"text"}]},{"type":"paragraph","content":[{"text":"Try Wardah PFA: ","type":"text"},{"text":"https://personalfaceanalysis.wardahbeauty.com/","type":"text","marks":[{"type":"link","attrs":{"href":"https://personalfaceanalysis.wardahbeauty.com/"}}]}]},{"type":"paragraph","content":[{"text":"Notes:","type":"text","marks":[{"type":"bold"}]}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Face data & consent: Use only your own face, or people who have clearly consented.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Sharing with Wardah: PFA-track projects may be shared with Wardah. To opt out, tell an organizer at the venue.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Filming: The PFA track will be filmed.","type":"text"}]}]}]},{"type":"heading","attrs":{"level":2},"content":[{"text":"What to Expect","type":"text"}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"MicroLumin AR glasses handed out to teams for the build","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"SDK access and docs shared before the event so you can start early","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Opening remarks Friday from Dr. Dai Zhaoen, Founder & CEO, MicroLumin (~10 min), and an industry talk by Dr. Dai on Saturday at 4:45 PM","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Hacking Friday evening, then a full build day Saturday","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Teams of 4–5 (mandatory), assigned at team formation","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Live demos on the device, worn by your team, in front of the judges","type":"text"}]}]}]},{"type":"heading","attrs":{"level":2},"content":[{"text":"Schedule","type":"text"}]},{"type":"paragraph","content":[{"text":"Friday, Nov 20","type":"text","marks":[{"type":"bold"}]}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"6:30 PM: Check-in","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"7:15 PM: Kickoff, with opening remarks from Dr. Dai Zhaoen, Founder & CEO, MicroLumin (~10 min)","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"7:35 PM: SDK brief","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"8:00 PM: Team formation. Teams of 4–5 (mandatory), assigned at team formation.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"8:45 PM: Hardware distribution. Teams lock at 8:45 PM.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"9:00 PM: Hacking begins · 90 min hardware testing","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"10:30 PM: Venue closes — everyone out. No overnight stay.","type":"text"}]}]}]},{"type":"paragraph","content":[{"text":"Saturday, Nov 21","type":"text","marks":[{"type":"bold"}]}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"8:00 AM: Breakfast","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"9:00 AM: Team check-ins","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"10:00 AM: SDK & hardware workshop","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"11:00 AM: Pitch workshop","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"12:30 PM: Lunch","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"2:00 PM: Submissions close","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"2:15 PM: Open-house judging · demo at your table","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"3:45 PM: Finalists announced","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"4:00 PM: Finalist stage demos (3 minutes, worn by the team, plus 2 minutes of Q&A)","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"4:45 PM: Industry talk · Dr. Dai, MicroLumin, while judges deliberate","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"5:30 PM: Awards","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"6:00 PM: Hardware return & wrap","type":"text"}]}]}]},{"type":"paragraph","content":[{"text":"Please note","type":"text","marks":[{"type":"bold"}]}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Teams of 4–5 (mandatory), assigned at team formation. Teams lock at 8:45 PM Friday.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Team changes after lock need organizer approval. Existing projects: disclose prior work.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Everyone out of the building by 10:30 PM Friday. No overnight stay.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Take your belongings with you. They are your own responsibility.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Handle MicroLumin devices with care. They stay onsite and go back to staff after every use.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Return in person Saturday to submit and be judged, or the team is disqualified.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Submit via the Airtable form by Sat 2:00 PM ET. No late submissions or edits. Form: ","type":"text"},{"text":"https://airtable.com/app8Ssj6nZxQzh73T/pagpEUYCP2O1c425D/form","type":"text","marks":[{"type":"link","attrs":{"href":"https://airtable.com/app8Ssj6nZxQzh73T/pagpEUYCP2O1c425D/form"}}]}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"You keep ownership. MicroLumin gets access to submitted code (see the FAQ on ","type":"text"},{"text":"https://worn-hacks.com","type":"text","marks":[{"type":"link","attrs":{"href":"https://worn-hacks.com"}}]},{"text":").","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Entry is first come, first served because spots are limited. Once we reach capacity at 140 people, we will not be able to admit additional hackers.","type":"text"}]}]}]},{"type":"heading","attrs":{"level":2},"content":[{"text":"How to get help","type":"text"}]},{"type":"paragraph","content":[{"text":"M6 glasses and SDK help: @dean_ml261120 in #ask-for-help (Dean, MicroLumin · on the Worn Discord).","type":"text"}]},{"type":"paragraph","content":[{"text":"Or find someone wearing a green lanyard. AI Society volunteers — look for green lanyards.","type":"text"}]},{"type":"heading","attrs":{"level":2},"content":[{"text":"Prizes","type":"text"}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"1st: $1,000 + 3 pairs of ML Vision M6","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"2nd: $500 + 2 pairs of ML Vision M6","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"3rd: $250 + 1 pair of ML Vision M6","type":"text"}]}]}]},{"type":"heading","attrs":{"level":2},"content":[{"text":"Judges","type":"text"}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Dr. Dai Zhaoen holds PhDs from Tsinghua and Oregon State. He's the founder and CEO of MicroLumin, whose CES 2026 award-winning M6 smart glasses are the hardware behind Worn.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Sam Shear, co-founder of Yes Hearing, scaled hearing care across all 50 US states, with c.$18m raised and over $30m in total sales, bringing expertise in accessibility, consumer adoption and healthcare commercialisation.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Michael Barone - Associate at Everywhere Ventures, a global pre-seed venture capital firm.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Samarpita Chowdhury - Co-founder of Root Access, leading the development of American-made electronic components. Electrical engineer with experience designing motherboards and processors for the U.S. military.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"D. J. Patel - VC | 3x exited founder.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Yiting Liu is a creative technologist specializing in XR and immersive experiences, founder of Vibes—a responsive experience studio for live events—and former Spatial Computing Tech Lead at Sia Partners, with interactive installation experience at Future Colossal and a Wellness Prize win at MIT Reality Hack 2022. ","type":"text"},{"text":"www.gotvibes.app","type":"text","marks":[{"type":"link","attrs":{"href":"https://www.gotvibes.app"}}]}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Serge KADJO - 15+ years hardware nerd building RL environments for Hardware (mechanical, electrical, firmware and manufacturing) engineering AI agents.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Harish Nanjala is Head of Strategy and Operations and Chief of Staff to the CEO at Beyond Alpha Ventures, where he focuses on investments in frontier technologies, including AI, quantum computing and digital assets.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Akash Mahtani - Founding HW engineer in Silicon Valley building the hardware-to-cloud layer for modern real estate @ Grid AI, previously working on wearable AI devices at a YC startup","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Luigi Rivolta - Building since 15, 2 exits, now founding engineer at stealth startup","type":"text"}]}]}]},{"type":"heading","attrs":{"level":2},"content":[{"text":"Who Should Attend","type":"text"}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Hardware Founders","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Engineers at companies like Meta, Amazon and Google who want to build on AR hardware","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"iOS and Android developers","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Hardware tinkerers, embedded and computer vision engineers","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Product designers interested in spatial and glanceable UI","type":"text"}]}]}]},{"type":"paragraph","content":[{"text":"Spots are limited and approval is required. You don't need prior AR experience, just the drive to build something real.","type":"text"}]},{"type":"heading","attrs":{"level":2},"content":[{"text":"Brought to you by","type":"text"}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"MicroLumin: Shenzhen-based maker of AR display glasses, including the M6 series and several CES 2026 award winners. MicroLumin is providing the hardware and SDK support for teams.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Waftech: Founded in 2007 and based in Penang, Malaysia, Waftech designs and manufactures wafer-handling and automation equipment for semiconductor manufacturing. Waftech delivers end-to-end, from R&D and design through manufacturing and after-sales service, and is ISO 9001:2015 certified. ","type":"text"},{"text":"https://waf-tech.com","type":"text","marks":[{"type":"link","attrs":{"href":"https://waf-tech.com"}}]}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"localhost:nyc: Making NYC the biggest startup ecosystem in the world.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Wardah: Indonesia’s leading halal beauty brand, from PT Paragon Technology and Innovation.","type":"text"}]}]}]},{"type":"heading","attrs":{"level":2},"content":[{"text":"In partnership with","type":"text"}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Cornell Tech AI Society","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"AI and Blockchain Club","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Indonesian Association at Cornell Tech","type":"text"}]}]}]},{"type":"heading","attrs":{"level":2},"content":[{"text":"Community Sponsors","type":"text"}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"434 VC is an early-stage venture capital fund investing in exceptional technical founders at the pre-seed and seed stages. Focused on AI infrastructure, Physical AI, and deep tech, 434 VC backs companies building the next generation of intelligent systems and critical technologies that will shape the future.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Treg is OpenRouter for agent tools. One token gives AI agents 4,000+ API endpoints across 113 providers (web scraping, news, finance, company and people enrichment, social profiles and trends, SERP data and more), with no provider accounts or API keys to juggle. Most calls cost a fraction of a cent.","type":"text"}]}]}]},{"type":"heading","attrs":{"level":2},"content":[{"text":"Organizers","type":"text"}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Stephen Jin: Lead organizer, Johnson MBA '27 at Cornell","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Somya Gupta: localhost:nyc team","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Vishal Kharker: localhost:nyc team","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Olivia Iarmak: localhost:nyc team · media","type":"text"}]}]}]}]},"eth_address_requirement":null,"faqs":null,"name_requirement":"full-name","phone_number_requirement":null,"solana_address_requirement":null,"registration_questions":[{"id":"p9pms1cj","label":"Are you a","options":["Founder","Engineer","Operator","GTM","Sales","Investor","Student"],"multiple":true,"required":true,"question_type":"select"},{"id":"imm9yb5g","label":"What company do you work for or school?","required":true,"question_type":"company","job_title_label":"What is your job title?","collect_job_title":true},{"id":"efi4hdzg","label":"What is your LinkedIn profile?","required":true,"qu