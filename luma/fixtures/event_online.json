"text"},{"text":"Martine Nilsen (Community @ Anthropic)","type":"text","marks":[{"type":"bold"}]},{"text":" and ","type":"text"},{"text":"Justin Elliott (Claude Community Ambassador, Miami)","type":"text","marks":[{"type":"bold"}]},{"text":" as we introduce the ","type":"text"},{"text":"Claude Community Ambassador Caribbean Program","type":"text","marks":[{"type":"bold"}]},{"text":".","type":"text"}]},{"type":"paragraph","content":[{"text":"This is an open conversation for builders, founders, developers, students, creatives, and community leaders across the islands who are excited about AI and want to help grow the ecosystem.","type":"text"}]},{"type":"paragraph","content":[{"text":"What we'll cover:","type":"text","marks":[{"type":"bold"}]}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"🌎 The vision for Claude Community across the Caribbean","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"🤝 What it means to become a Claude Community Ambassador","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"🚀 Opportunities to organize events, build communities, and connect with the global Claude ecosystem","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"💡 How we can empower Caribbean talent to build with AI","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"🎤 Your questions, ideas, and feedback!","type":"text"}]}]}]},{"type":"paragraph","content":[{"text":"📅 Friday, October 23, 2026","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","content":[{"text":"🕕 6:00 PM EST / 3:00 PM PST","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","content":[{"text":"📍 Virtual | Open to the entire Caribbean","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","content":[{"text":"Whether you're already building with Claude or just curious about getting involved, this conversation is for you.","type":"text"}]},{"type":"paragraph","content":[{"text":"One Caribbean. Many islands. Unlimited possibilities.","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","content":[{"text":"Come with questions. Leave with connections. Let's build something meaningful together.","type":"text"}]},{"type":"paragraph","content":[{"text":"Register now and be part of the conversation!","type":"text","marks":[{"type":"bold"}]}]}]},"eth_address_requirement":null,"faqs":null,"name_requirement":"full-name","phone_number_requirement":null,"solana_address_requirement":null,"registration_questions":[{"id":"blmyeaon","label":"What is your experience level with Claude Code?","options":["Daily user","Regular user (multiple times per week)","Occasional user","New but highly interested"],"required":true,"question_type":"select"},{"id":"jd03neb2","label":"What Claude Code features or capabilities are you most interested in discussing at this meetup?","required":true,"question_type":"text"},{"id":"83hutf4t","label":"Where do you work or study?","required":true,"question_type":"text"},{"id":"qtfayj0k","label":"Number of employees at your company?","options":["1-500","501-5000","5000+","n/a"],"required":true,"question_type":"select"},{"id":"jpkk88jy","label":"What is your role? (If Student, write Student)","required":true,"question_type":"text"},{"id":"ed381niv","label":"What is your LinkedIn profile?","required":false,"question_type":"url"},{"id":"b6ona22h","label":"Terms and Conditions","terms":{"url":"https://support.claude.com/en/articles/12933905-claude-community-event-terms-and-acknowledgments","content_type":"link","collect_signature":true},"required":true,"question_type":"terms"},{"id":"l9m5ddgm","label":"I would like to receive the Claude Developer Newsletter from Anthropic.","required":false,"question_type":"agree-check"}],"prefilled_answers":{},"is_flagged":false,"is_managing_calendar_admin":false,"show_unlock_code_optio