alid_end_at":null,"valid_start_at":null,"num_tickets_registered":33,"num_guests":33,"spots_remaining":null,"is_disabled":false}],"featured_infos":[],"categories":[{"api_id":"cat-ai","description":"Join a hackathon, learn about LLMs and prompt engineering, or connect with other AI practitioners.","event_count":3226,"hero_image_desktop_url":"https://images.lumacdn.com/uploads/42/5719a861-c421-4624-a9dc-8b8b73e3cf57.png","icon_url":"https://images.lumacdn.com/uploads/0z/c1143c0e-a2ab-4434-b82b-80b0ba3ec2f0.png","name":"AI","page_title":"AI Events","simple_icon_url":"https://images.lumacdn.com/uploads/2g/4121b0fa-bd9e-4a50-ad85-cf0000b6d919.png","slug":"ai","social_image_url":"https://images.lumacdn.com/uploads/c1/486065e1-2511-4577-a0e0-5eb683d38a3d.png","subscriber_count":115563,"tint_color":"#D96D9B"},{"api_id":"cat-climate","description":"Find climate events from major conferences to local gatherings. Learn about deep tech, discuss climate policies, and join an hour of action.","event_count":533,"hero_image_desktop_url":"https://images.lumacdn.com/uploads/ho/95479740-769f-4fa2-9b59-c9c153343db7.png","icon_url":"https://images.lumacdn.com/uploads/on/19946552-9254-41de-b105-d086a2e4ac68.png","name":"Climate","page_title":"Climate Events","simple_icon_url":"https://images.lumacdn.com/uploads/vl/4e0fef92-42a9-4d4d-ae86-c4da46965cf7.png","slug":"climate","social_image_url":"https://images.lumacdn.com/uploads/11/e23d070d-725a-4bdf-bab7-ba45de6d0237.png","subscriber_count":12431,"tint_color":"#60AD57"}],"ticket_info":{"price":null,"is_free":true,"max_price":null,"is_sold_out":false,"spots_remaining":null,"is_near_capacity":false,"require_approval":false},"registration_availability":"open","subscribed_to_calendar":false,"collaborating_calendars":[],"event_invite":null,"manager_info":null,"guest_info":null,"host_info":null,"sold_out":false,"locale":"en","theme_meta":{"name":"Lavender","type":"shader","theme":"shader-light","color1":"#e4ccff","color2":"#e9cffc","color3":"#f3ccff"},"ticket_transfer_enabled":false,"tint_color":"#e9cffc","can_register_for_multiple_tickets":false,"font_title":null,"description_mirror":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"Three hours. A team. A challenge. What could you come up with? 💡","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","content":[{"text":"Join us for a hands-on Mini Hackathon where you'll team up with other students, tackle a real-world challenge and turn your ideas into a potential business concept.","type":"text"}]},{"type":"paragraph","content":[{"text":"No business experience? No problem. Can't code? Doesn't matter. Just bring your curiosity and creativity!","type":"text"}]},{"type":"paragraph","content":[{"text":"🎯 Choose your challenge","type":"text"}]},{"type":"paragraph","content":[{"text":"🌱 ","type":"text"},{"text":"Challenge 1: One Person's Waste, Another's Business! – Sustainability & Circular Economy","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","content":[{"text":"Can you turn waste, unused materials or everyday resources into a valuable business opportunity? Think creatively about making sustainability profitable!","type":"text"}]},{"type":"paragraph","content":[{"text":"🤖 ","type":"text"},{"text":"Challenge 2: AI Changes Everything! – AI & New Business Models","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","content":[{"text":"How could AI make an existing business, service or everyday activity better? Imagine new solutions, explore opportunities and create something innovative!","type":"text"}]},{"type":"paragraph","content":[{"text":"🎤 Meet your host","type":"text"}]},{"type":"paragraph","content":[{"text":"Tuomas Hongisto","type":"text","marks":[{"type":"bold"}]},{"type":"hard_break"},{"text":"Entrepreneur at Luova Tuho | Doctoral Researcher at LUT","type":"text"}]},{"type":"paragraph","content":[{"text":"Learn about entrepreneurial thinking, Lean Startup principles and AI-assisted innovation with guidance from Tuomas.","type":"text"}]},{"type":"paragraph","content":[{"text":"⚡ What to expect","type":"text"}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Learn how to turn problems into business opportunities.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Work in a team to develop your own business concept.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Use AI and creative thinking to explore solutions.","type":"text"}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"text":"Pitch your idea and compete for prizes! 🏆","type":"text"}]}]}]},{"type":"paragraph","content":[{"text":"👥 Come with a team or find yours here!","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","content":[{"text":"Bring your friends and form a team of up to ","type":"text"},{"text":"4 students","type":"text","marks":[{"type":"bold"}]},{"text":". Coming alone? No worries! We'll help you find a team at the event. It's a great chance to meet students from different fields, combine your skills and create something together.","type":"text"}]},{"type":"paragraph","content":[{"text":"Different backgrounds bring different perspectives. You never know what your team might come up with!","type":"text"}]},{"type":"paragraph","content":[{"text":"Only 30 places available!","type":"text"}]},{"type":"paragraph","content":[{"text":"🎓 Xamk Award friendly!","type":"text","marks":[{"type":"bold"}]}]},{"type":"paragraph","content":[{"text":"Come with an idea or come with none. Either way, leave with something new!","type":"text"}]}]},"eth_address_requirement":null,"faqs":null,"name_requirement":"full-name","phone_number_requirement":null,"solana_address_requirement":null,"registration_questions":[{"id":"swqdb39n","label":"Are you student at Xamk? If yes, which degree?","required":true,"question_type":"text"},{"id":"bj8zxsuk","label":"H